          <speciesReference species="M_adp_c" stoichiometry="1" constant="true"/>
          <speciesReference species="M_h_c" stoichiometry="1" constant="true"/>
        </listOfProducts>
      </reaction>
      <reaction id="R_GLYC" name="glycolysis (g6p -&gt; 2 pyruvate, net +3 ATP from g6p)" reversible="false" fast="false" fbc:lowerFluxBound="cobra_0_bound" fbc:upperFluxBound="cobra_default_ub">
        <notes>
          <html xmlns="http://www.w3.org/1999/xhtml">
            <p>comment: Net glucose-&gt;2 pyruvate = +2 ATP (=-1 at HEX +3 here), matching the figure&apos;s &apos;2 ATP&apos;.</p>
