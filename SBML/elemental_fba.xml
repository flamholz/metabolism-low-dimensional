      </reaction>
      <reaction id="R_PDH" name="pyruvate dehydrogenase (pyruvate -&gt; acetyl-CoA + CO2)" reversible="false" fast="false" fbc:lowerFluxBound="cobra_0_bound" fbc:upperFluxBound="cobra_default_ub">
