          <speciesReference species="M_co2_c" stoichiometry="1" constant="true"/>
          <speciesReference species="M_nadph_c" stoichiometry="2" constant="true"/>
          <speciesReference species="M_h_c" stoichiometry="2" constant="true"/>
        </listOfProducts>
      </reaction>
      <reaction id="R_PPP_RECYCLE" name="non-oxidative PPP (recycle pentose to hexose-P)" reversible="true" fast="false" fbc:lowerFluxBound="cobra_default_lb" fbc:upperFluxBound="cobra_default_ub">
